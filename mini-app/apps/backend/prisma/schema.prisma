// Prisma schema for PostgreSQL database
// This is the initial schema - will be expanded in later phases

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// User model
model User {
  id               String   @id @default(uuid())
  telegramId       BigInt   @unique @map("telegram_id")
  username         String?
  firstName        String?  @map("first_name")
  lastName         String?  @map("last_name")
  languageCode     String?  @map("language_code")
  botLanguage      String?  @map("bot_language")
  photoUrl         String?  @map("photo_url")
  isPremium        Boolean  @default(false) @map("is_premium")
  // Admin moderation flags. `isBlocked` blocks the user from playing
  // and from withdrawing; `withdrawalLocked` lets them play but
  // prevents withdrawals while a case is investigated.
  isBlocked        Boolean  @default(false) @map("is_blocked")
  withdrawalLocked Boolean  @default(false) @map("withdrawal_locked")
  // Free-text moderation note set by admins.
  adminNote        String?  @map("admin_note") @db.Text
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  // Win Streak tracking
  currentWinStreak Int      @default(0) @map("current_win_streak")
  winStreakActive  Boolean  @default(false) @map("win_streak_active")

  sessions               Session[]
  gameSessions           GameSession[]
  userRtpConfig          UserRtpConfig?
  balance                Balance?
  bets                   Bet[]
  transactions           Transaction[]
  tournamentParticipants TournamentParticipant[]
  securityAlerts         SecurityAlert[]
  userIpAddresses        UserIpAddress[]
  macvpayOrders          MacvpayOrder[]
  withdrawalRequests     WithdrawalRequest[]

  @@index([telegramId])
  @@index([isBlocked])
  @@map("users")
}

// Session model for JWT management
model Session {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  token     String   @unique
  ipAddress String?  @map("ip_address")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([ipAddress])
  @@index([expiresAt])
  @@map("sessions")
}

// User IP Tracking
model UserIpAddress {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  ipAddress String   @map("ip_address")
    deviceId  String?  @map("device_id")
  count     Int      @default(1)
  isRoot    Boolean  @default(false) @map("is_root")
  isVpn     Boolean  @default(false) @map("is_vpn")
  firstSeen DateTime @default(now()) @map("first_seen")
  lastSeen  DateTime @default(now()) @map("last_seen")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, ipAddress])
  @@index([ipAddress])
  @@map("user_ip_addresses")
}

// Balance model (1:1 with User)
model Balance {
  id              String   @id @default(uuid())
  userId          String   @unique @map("user_id")
  amount          Decimal  @default(0) @db.Decimal(20, 2)
  currency        String   @default("PLN")
  demoMode        Boolean  @default(false) @map("demo_mode")
  wagerTarget     Decimal  @default(0) @map("wager_target") @db.Decimal(20, 2)
  wagerProgress   Decimal  @default(0) @map("wager_progress") @db.Decimal(20, 2)
  autoRtpTarget   Decimal  @default(0) @map("auto_rtp_target") @db.Decimal(20, 2)
  autoRtpProgress Decimal  @default(0) @map("auto_rtp_progress") @db.Decimal(20, 2)
  lastSyncedAt    DateTime @default(now()) @map("last_synced_at")
  version         Int      @default(0) // Optimistic locking
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("balances")
}

// Security Alerts for Anti-Fraud
model SecurityAlert {
  id          String   @id @default(uuid())
  type        String // e.g. "multi_account"
  severity    String // "low", "medium", "high", "critical"
  userId      String   @map("user_id")
  description String   @db.Text
  resolved    Boolean  @default(false)
  createdAt   DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([resolved])
  @@index([type])
  @@map("security_alerts")
}

// ----------------------------------------------------------------------
// Missing tables added to prevent Prisma from dropping them
// ----------------------------------------------------------------------

model Broadcast {
  id            String   @id
  status        String
  text          String   @db.Text
  parseMode     String   @map("parse_mode")
  mediaUrl      String?  @map("media_url")
  buttons       Json?
  audience      Json
  scheduledAt   DateTime? @map("scheduled_at")
  startedAt     DateTime? @map("started_at")
  finishedAt    DateTime? @map("finished_at")
  totalTargets  Int      @default(0) @map("total_targets")
  delivered     Int      @default(0)
  failed        Int      @default(0)
  createdBy     String   @map("created_by")
  createdByTg   BigInt   @map("created_by_tg")
  errorMessage  String?  @map("error_message") @db.Text
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @default(now()) @updatedAt @map("updated_at")

  recipients BroadcastRecipient[]
  
  @@map("broadcasts")
}

model BroadcastRecipient {
  id            Int      @id @default(autoincrement())
  broadcastId   String   @map("broadcast_id")
  telegramId    BigInt   @map("telegram_id")
  status        String
  error         String?  @db.Text

  broadcast Broadcast @relation(fields: [broadcastId], references: [id], onDelete: Cascade)
  
  @@unique([broadcastId, telegramId])
  @@map("broadcast_recipients")
}

model MacvpayOrder {
  id              String   @id
  userId          String   @map("user_id")
  externalId      String   @map("external_id")
  requestedAmount Decimal  @map("requested_amount") @db.Decimal(12, 2)
  uniqueAmount    Decimal  @map("unique_amount") @db.Decimal(12, 2)
  currency        String
  paymentType     String   @map("payment_type")
  card            String?
  recipient       String?
  details         String?
  status          String
  expiresAt       DateTime @map("expires_at")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @default(now()) @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@map("macvpay_orders")
}

model WithdrawalRequest {
  id          String   @id
  userId      String   @map("user_id")
  amount      Decimal  @db.Decimal(12, 2)
  currency    String
  method      String
  destination String
  status      String
  metadata    Json?
  reviewedAt  DateTime? @map("reviewed_at")
  reviewedBy  String?   @map("reviewed_by")
  rejectionReason String? @map("rejection_reason") @db.Text
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@map("withdrawal_requests")
}

// Transaction model
model Transaction {
  id            String   @id @default(uuid())
  userId        String   @map("user_id")
  type          String // bet, win, deposit, withdrawal, refund
  amount        Decimal  @db.Decimal(20, 2)
  balanceBefore Decimal  @map("balance_before") @db.Decimal(20, 2)
  balanceAfter  Decimal  @map("balance_after") @db.Decimal(20, 2)
  gameType      String?  @map("game_type")
  gameRoundId   String?  @map("game_round_id")
  metadata      Json?
  createdAt     DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([gameType])
  @@index([createdAt])
  @@map("transactions")
}

// Game round model (base structure)
model GameRound {
  id             String    @id @default(uuid())
  gameType       String    @map("game_type")
  state          String // idle, waiting, starting, active, resolving, completed, cancelled
  serverSeedHash String    @map("server_seed_hash")
  serverSeed     String?   @map("server_seed")
  clientSeed     String?   @map("client_seed")
  nonce          Int       @default(0)
  result         Json? // Game-specific result data
  metadata       Json?
  startedAt      DateTime? @map("started_at")
  endedAt        DateTime? @map("ended_at")
  createdAt      DateTime  @default(now()) @map("created_at")

  @@index([gameType])
  @@index([state])
  @@index([createdAt])
  @@map("game_rounds")
}

// Bet model
model Bet {
  id         String    @id @default(uuid())
  userId     String    @map("user_id")
  roundId    String    @map("round_id")
  gameType   String    @map("game_type")
  amount     Decimal   @db.Decimal(20, 2)
  state      String // pending, active, won, lost, cancelled, cashed_out
  payout     Decimal?  @db.Decimal(20, 2)
  multiplier Decimal?  @db.Decimal(10, 4) // 4 decimals for crash precision
  metadata   Json?
  placedAt   DateTime  @default(now()) @map("placed_at")
  resolvedAt DateTime? @map("resolved_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([roundId])
  @@index([gameType])
  @@index([state])
  @@index([placedAt])
  @@map("bets")
}

// Admin audit log — every mutating admin action is recorded here.
//
// SECURITY: this is append-only. There is no UI to delete rows, and
// every endpoint that records here uses `prisma.adminAuditLog.create`
// directly — never raw SQL. The log lives forever; we cap visibility
// in the UI with paging, but the rows are never trimmed automatically.
model AdminAuditLog {
  id              String   @id @default(uuid())
  // The admin who performed the action.
  adminUserId     String   @map("admin_user_id")
  adminTelegramId BigInt   @map("admin_telegram_id")
  // Free-form action verb, e.g. "user.block", "balance.credit".
  action          String
  // Type / id of the entity that was modified.
  targetType      String   @map("target_type")
  targetId        String?  @map("target_id")
  // Snapshots before / after for diff'ing in the audit viewer.
  payloadBefore   Json?    @map("payload_before")
  payloadAfter    Json?    @map("payload_after")
  // Free-text reason supplied by the admin (mandatory for balance ops).
  reason          String?  @db.Text
  ipAddress       String?  @map("ip_address")
  createdAt       DateTime @default(now()) @map("created_at")

  @@index([adminUserId])
  @@index([targetType, targetId])
  @@index([action])
  @@index([createdAt])
  @@map("admin_audit_log")
}

// =====================================================================
// Bonuses subsystem
// =====================================================================
//
// Three pillars:
//   1. Promo codes — admin-created codes a player redeems for a fixed
//      bonus amount. Each code has a usage cap (per-user + total).
//   2. Lucky Wheel — daily free spins, payout 0.05..1.00 PLN. Cooldown
//      between spins is enforced.
//   3. Contests — admins create a pool with eligibility rules; the
//      winners are picked at end-of-window from the qualifying set.
//
// All bonus payouts go to the user's main balance (no separate bonus
// wallet) — keeps accounting simple and matches what the user
// requested.

/// Promo code definition. Created by admins; redeemed by users.
model PromoCode {
  id              String    @id @default(uuid())
  /// Display code in upper-case (e.g. "WELCOME10"). Unique.
  code            String    @unique
  /// Bonus amount credited per redemption.
  amount          Decimal   @db.Decimal(20, 2)
  currency        String    @default("PLN")
  /// Max total redemptions across all users. NULL = unlimited.
  maxRedemptions  Int?      @map("max_redemptions")
  /// Max redemptions per single user. Default 1.
  perUserLimit    Int       @default(1) @map("per_user_limit")
  /// Optional expiry. Past this timestamp the code becomes invalid.
  expiresAt       DateTime? @map("expires_at")
  /// Admin who created it.
  createdByUserId String    @map("created_by_user_id")
  /// Soft-disable without deleting. Admin can re-enable later.
  active          Boolean   @default(true)
  /// Free-text comment so the admin remembers what the code was for.
  note            String?   @db.Text
  /// Extra rules for eligibility (e.g. deposit requirements)
  rules           Json?     @default("[]")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  redemptions PromoRedemption[]

  @@index([code])
  @@index([active])
  @@map("promo_codes")
}

/// One row per (user, promo code) redemption.
model PromoRedemption {
  id          String   @id @default(uuid())
  promoCodeId String   @map("promo_code_id")
  userId      String   @map("user_id")
  amount      Decimal  @db.Decimal(20, 2)
  createdAt   DateTime @default(now()) @map("created_at")

  promoCode PromoCode @relation(fields: [promoCodeId], references: [id], onDelete: Cascade)

  @@unique([promoCodeId, userId, createdAt], map: "promo_redemptions_promocode_user_at_uq")
  @@index([promoCodeId])
  @@index([userId])
  @@map("promo_redemptions")
}

/// Each Lucky-Wheel spin a user makes. Used to enforce the 10/day +
/// 20-min cooldown rules and to feed the recent-spin ticker.
model BonusWheelSpin {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  /// Amount won, 0.05..1.00 PLN.
  amount    Decimal  @db.Decimal(20, 2)
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId, createdAt])
  @@index([createdAt])
  @@map("bonus_wheel_spins")
}

/// Contest definition. Eligibility rules are stored as JSON so we can
/// add new rule types without a migration.
model Contest {
  id              String   @id @default(uuid())
  title           String
  description     String?  @db.Text
  /// "public" — visible on the bonuses page; "private" — joinable
  /// only via a referral link served by the bot.
  visibility      String   @default("public")
  bannerUrl       String?  @map("banner_url") @db.Text
  /// Total prize pool in PLN.
  prizePool       Decimal  @map("prize_pool") @db.Decimal(20, 2)
  /// Number of winners selected at the end. Must be >= 1.
  winnersCount    Int      @map("winners_count")
  /// Total wager a winner gets.
  winnerWager     Decimal  @default(0) @map("winner_wager") @db.Decimal(20, 2)
  /// Per-place distribution. Array of `{ place: number, amount: number }`
  /// summing to `prizePool`. If the array length is shorter than
  /// `winnersCount`, the remainder splits the last entry equally.
  prizeShares     Json     @map("prize_shares")
  /// Eligibility rules. Array of rule objects, all must pass:
  ///   { type: 'deposit_window', amount: number, days: number }
  ///   { type: 'wagered_window', amount: number, days: number }
  ///   { type: 'deposit_total',  amount: number }
  ///   { type: 'referrals',      count: number }
  ///   { type: 'registered_after', date: ISO-8601 }
  rules           Json
  startsAt        DateTime @map("starts_at")
  endsAt          DateTime @map("ends_at")
  /// Picked temporarily during /draw before confirmation
  draftWinners    Json?    @map("draft_winners")
  /// Filled in by `/draw`: array of `{ userId, amount, place }` once
  /// winners are picked. Null while pending.
  resolvedWinners Json?    @map("resolved_winners")
  /// State machine: 'scheduled', 'live', 'closed', 'paid'.
  state           String   @default("scheduled")
  createdByUserId String   @map("created_by_user_id")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  participants ContestParticipant[]

  @@index([visibility, state])
  @@index([endsAt])
  @@map("contests")
}

/// Per-user participation record. For private contests, written when
/// the bot redirects the user with the contest's referral token. For
/// public contests, written lazily once the user opens the page (so
/// the leaderboard shows current totals against rules).
model ContestParticipant {
  id        String   @id @default(uuid())
  contestId String   @map("contest_id")
  userId    String   @map("user_id")
  /// True when the admin disqualifies the user — they stay listed but
  /// can no longer be picked as a winner. Set via the contest card.
  banned    Boolean  @default(false)
  joinedAt  DateTime @default(now()) @map("joined_at")

  contest Contest @relation(fields: [contestId], references: [id], onDelete: Cascade)

  @@unique([contestId, userId])
  @@index([userId])
  @@map("contest_participants")
}

/// Tournament definition with daily 10h cycles. startAtGmt1 is the
/// first cycle start in GMT+1; each following cycle starts +24h.
model Tournament {
  id              String   @id @default(uuid())
  title           String
  description     String?  @db.Text
  bannerUrl       String?  @map("banner_url")
  gameType        String   @map("game_type")
  prizePool       Decimal  @map("prize_pool") @db.Decimal(20, 2)
  prizeMode       String   @map("prize_mode") // 'percent' | 'fixed'
  winnersCount    Int      @map("winners_count")
  fixedPrize      Decimal? @map("fixed_prize") @db.Decimal(20, 2)
  wagerMultiplier Int      @default(0) @map("wager_multiplier")
  startBalance    Decimal  @map("start_balance") @db.Decimal(20, 2)
  entryFee        Decimal  @map("entry_fee") @db.Decimal(20, 2)
  startAtGmt1     DateTime @map("start_at_gmt1")
  durationHours   Int      @map("duration_hours")
  repeatType      String   @default("daily") @map("repeat_type")
  active          Boolean  @default(true)
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  cycles TournamentCycle[]

  @@index([active])
  @@index([gameType, active])
  @@map("tournaments")
}

/// Per-day window of a tournament.
model TournamentCycle {
  id           String   @id @default(uuid())
  tournamentId String   @map("tournament_id")
  startsAt     DateTime @map("starts_at")
  endsAt       DateTime @map("ends_at")
  prizePool    Decimal  @map("prize_pool") @db.Decimal(20, 2)
  state        String   @default("live")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  tournament   Tournament              @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  participants TournamentParticipant[]

  @@unique([tournamentId, startsAt])
  @@index([tournamentId, endsAt])
  @@map("tournament_cycles")
}

/// Participant state for a specific cycle (tournament + day).
model TournamentParticipant {
  id            String    @id @default(uuid())
  cycleId       String    @map("cycle_id")
  userId        String    @map("user_id")
  balance       Decimal   @db.Decimal(20, 2)
  joinedAt      DateTime  @default(now()) @map("joined_at")
  reachedAt     DateTime  @map("reached_at")
  refreshCount  Int       @default(0) @map("refresh_count")
  lastRefreshAt DateTime? @map("last_refresh_at")

  cycle TournamentCycle @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  user  User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([cycleId, userId])
  @@index([userId])
  @@map("tournament_participants")
}

// -----------------------------------------------------------------------------
// Session & Win Streak Tracking
// -----------------------------------------------------------------------------

model GameSession {
  id             String   @id @default(uuid())
  userId         String   @map("user_id")
  startBalance   Decimal  @db.Decimal(20, 2) @map("start_balance")
  lastActivityAt DateTime @default(now()) @map("last_activity_at")
  createdAt      DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([lastActivityAt])
  @@map("game_sessions")
}

// -----------------------------------------------------------------------------
// Persistent RTP Config
// -----------------------------------------------------------------------------

model SystemConfig {
  id        String   @id @default(uuid())
  key       String   @unique
  value     Json
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("system_configs")
}

model UserRtpConfig {
  id        String   @id @default(uuid())
  userId    String   @unique @map("user_id")
  mode      String
  target    Float
  windowMs  Int      @map("window_ms")
  intensity Float
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_rtp_configs")
}
