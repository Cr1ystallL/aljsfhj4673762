# Server Configuration
NODE_ENV=development
PORT=4000
HOST=0.0.0.0

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/casino_miniapp

# Redis
REDIS_URL=redis://localhost:6379

# JWT (CRITICAL: Generate a strong secret for production)
# Use: openssl rand -base64 32
JWT_SECRET=

# Telegram Bot
TELEGRAM_BOT_TOKEN=

# Python Bot Integration (for balance sync)
PYTHON_BOT_API_URL=http://localhost:8000
PYTHON_BOT_API_KEY=

# Rate Limiting
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000

# CORS
CORS_ORIGIN=http://localhost:3000

# Admin allow-list — comma-separated Telegram user IDs that may access
# the covert /api/_x/* endpoints. Empty by default; the admin surface is
# completely hidden when not set.
# The Python bot in the same repo uses ADMIN_IDS for the same purpose,
# and the backend will fall back to ADMIN_IDS when ADMIN_TELEGRAM_IDS is
# missing — set whichever you prefer (both is fine, the more specific
# one wins).
ADMIN_TELEGRAM_IDS=

# Prisma Connection Pool (Production)
# DATABASE_POOL_MIN=2
# DATABASE_POOL_MAX=10
# DATABASE_POOL_TIMEOUT=30000
